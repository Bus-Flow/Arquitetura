<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_AsIs_v3" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:collaboration id="Collaboration_AsIs_v3">
    <bpmn:participant id="Participant_Motorista_v3" name="Motorista (Operação de Campo)" processRef="Process_Motorista_v3" />
    <bpmn:participant id="Participant_CCO_v3" name="Centro de Controle Operacional (CCO)" processRef="Process_CCO_v3" />
    <bpmn:participant id="Participant_Garagem_v3" name="Garagem de Veículos" processRef="Process_Garagem_v3" />
    <bpmn:messageFlow id="Flow_Msg_Motorista_to_CCO" name="Notificar ocorrência / bloqueio por chuva (Rádio/Telefone)" sourceRef="Activity_Motorista_ReportarOcorrencia" targetRef="Activity_CCO_ReceberOcorrencia" />
    <bpmn:messageFlow id="Flow_Msg_CCO_to_Motorista" name="Orientar troca de itinerário / desvio" sourceRef="Activity_CCO_OrientarTroca" targetRef="Activity_Motorista_ReceberOrientacao" />
    <bpmn:messageFlow id="Flow_Msg_CCO_to_Garagem" name="Solicitar veículo extra à garagem (Reativo pós-chuva)" sourceRef="Activity_CCO_SolicitarVeiculoExtra" targetRef="Activity_Garagem_ReceberPedidoExtra" />
    <bpmn:textAnnotation id="TextAnnotation_AsIs_GargaloCCO">
      <bpmn:text>GARGALO OPERACIONAL (AS-IS):
Tomada de decisão empírica e 100% reativa. O CCO só solicita carros extras à garagem ou orienta desvio APÓS a chuva causar o colapso da linha.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_AsIs_GargaloCCO" sourceRef="Activity_CCO_AvaliarImpacto" targetRef="TextAnnotation_AsIs_GargaloCCO" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Motorista_v3" isExecutable="false">
    <bpmn:sequenceFlow id="Flow_Mot_1" sourceRef="Event_Motorista_Inicio" targetRef="SubProcess_PreparacaoPatio" />
    <bpmn:sequenceFlow id="Flow_Mot_2" sourceRef="SubProcess_PreparacaoPatio" targetRef="Activity_Motorista_IniciarOperacao" />
    <bpmn:sequenceFlow id="Flow_Mot_3" sourceRef="Activity_Motorista_IniciarOperacao" targetRef="Gateway_Motorista_Ocorrencia" />
    <bpmn:sequenceFlow id="Flow_Mot_OcorrenciaNao" name="Não" sourceRef="Gateway_Motorista_Ocorrencia" targetRef="Activity_Motorista_ContinuarOperacao" />
    <bpmn:sequenceFlow id="Flow_Mot_OcorrenciaSim" name="Sim" sourceRef="Gateway_Motorista_Ocorrencia" targetRef="Activity_Motorista_ReportarOcorrencia" />
    <bpmn:sequenceFlow id="Flow_Mot_4" sourceRef="Activity_Motorista_ReceberOrientacao" targetRef="Activity_Motorista_ExecutarNovoItinerario" />
    <bpmn:sequenceFlow id="Flow_Mot_5" sourceRef="Activity_Motorista_ExecutarNovoItinerario" targetRef="Activity_Motorista_ContinuarOperacao" />
    <bpmn:sequenceFlow id="Flow_Mot_6" sourceRef="Activity_Motorista_ContinuarOperacao" targetRef="Activity_Motorista_RealizarPercurso" />
    <bpmn:sequenceFlow id="Flow_Mot_7" sourceRef="Activity_Motorista_RealizarPercurso" targetRef="Activity_Motorista_ChegarPontoFinal" />
    <bpmn:sequenceFlow id="Flow_Mot_8" sourceRef="Activity_Motorista_ChegarPontoFinal" targetRef="Gateway_Motorista_FimTurno" />
    <bpmn:sequenceFlow id="Flow_Mot_TurnoSim" name="Sim" sourceRef="Gateway_Motorista_FimTurno" targetRef="Activity_Motorista_FinalizarOperacao" />
    <bpmn:sequenceFlow id="Flow_Mot_TurnoNao" name="Não" sourceRef="Gateway_Motorista_FimTurno" targetRef="Activity_Motorista_ContinuarOperacao" />
    <bpmn:sequenceFlow id="Flow_Mot_9" sourceRef="Activity_Motorista_FinalizarOperacao" targetRef="Event_Motorista_Fim" />
    <bpmn:manualTask id="Activity_Motorista_IniciarOperacao" name="Iniciar operação da linha">
      <bpmn:incoming>Flow_Mot_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Mot_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:subProcess id="SubProcess_PreparacaoPatio" name="Inspeção do Veículo na garagem">
      <bpmn:incoming>Flow_Mot_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Mot_2</bpmn:outgoing>
      <bpmn:startEvent id="Event_Sub_Inicio" name="Início da Preparação na garagem">
        <bpmn:outgoing>Flow_Sub_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:manualTask id="Activity_Sub_ReceberEscala" name="Receber escala do dia">
        <bpmn:incoming>Flow_Sub_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_2</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:manualTask id="Activity_Sub_LocalizarOnibus" name="Localizar ônibus escalado na garagem">
        <bpmn:incoming>Flow_Sub_2</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_3</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:manualTask id="Activity_Sub_InspecionarVeiculo" name="Inspecionar veículo (água, óleo, pneu)">
        <bpmn:incoming>Flow_Sub_3</bpmn:incoming>
        <bpmn:incoming>Flow_Sub_TrocaOK</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_4</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:exclusiveGateway id="Gateway_Sub_VeiculoApto" name="Veículo apto?" default="Flow_Sub_AptoSim">
        <bpmn:incoming>Flow_Sub_4</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_AptoNao</bpmn:outgoing>
        <bpmn:outgoing>Flow_Sub_AptoSim</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Activity_Sub_ComunicarManutencao" name="Comunicar manutenção">
        <bpmn:incoming>Flow_Sub_AptoNao</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateCatchEvent id="Event_Sub_TimerAguardar" name="Aguardar tempo de substituição do veículo">
        <bpmn:incoming>Flow_Sub_5</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_6</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_Sub" />
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="Activity_Sub_ReceberOutroVeiculo" name="Receber Veículo">
        <bpmn:incoming>Flow_Sub_6</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_TrocaOK</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="Event_Sub_Fim" name="Veículo Apto e Liberado para Operar">
        <bpmn:incoming>Flow_Sub_AptoSim</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Sub_1" sourceRef="Event_Sub_Inicio" targetRef="Activity_Sub_ReceberEscala" />
      <bpmn:sequenceFlow id="Flow_Sub_2" sourceRef="Activity_Sub_ReceberEscala" targetRef="Activity_Sub_LocalizarOnibus" />
      <bpmn:sequenceFlow id="Flow_Sub_3" sourceRef="Activity_Sub_LocalizarOnibus" targetRef="Activity_Sub_InspecionarVeiculo" />
      <bpmn:sequenceFlow id="Flow_Sub_4" sourceRef="Activity_Sub_InspecionarVeiculo" targetRef="Gateway_Sub_VeiculoApto" />
      <bpmn:sequenceFlow id="Flow_Sub_AptoNao" name="Não" sourceRef="Gateway_Sub_VeiculoApto" targetRef="Activity_Sub_ComunicarManutencao" />
      <bpmn:sequenceFlow id="Flow_Sub_AptoSim" name="Sim" sourceRef="Gateway_Sub_VeiculoApto" targetRef="Event_Sub_Fim" />
      <bpmn:sequenceFlow id="Flow_Sub_5" sourceRef="Activity_Sub_ComunicarManutencao" targetRef="Event_Sub_TimerAguardar" />
      <bpmn:sequenceFlow id="Flow_Sub_6" sourceRef="Event_Sub_TimerAguardar" targetRef="Activity_Sub_ReceberOutroVeiculo" />
      <bpmn:sequenceFlow id="Flow_Sub_TrocaOK" sourceRef="Activity_Sub_ReceberOutroVeiculo" targetRef="Activity_Sub_InspecionarVeiculo" />
    </bpmn:subProcess>
    <bpmn:startEvent id="Event_Motorista_Inicio" name="Início da Escala / Turno">
      <bpmn:outgoing>Flow_Mot_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_Motorista_Ocorrencia" name="Ocorrência / Gargalo por chuva identificado?" default="Flow_Mot_OcorrenciaNao">
      <bpmn:incoming>Flow_Mot_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Mot_OcorrenciaNao</bpmn:outgoing>
      <bpmn:outgoing>Flow_Mot_OcorrenciaSim</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_Motorista_ReportarOcorrencia" name="Notificar ocorrência à central">
      <bpmn:incoming>Flow_Mot_OcorrenciaSim</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:manualTask id="Activity_Motorista_ContinuarOperacao" name="Continuar operação">
      <bpmn:incoming>Flow_Mot_OcorrenciaNao</bpmn:incoming>
      <bpmn:incoming>Flow_Mot_5</bpmn:incoming>
      <bpmn:incoming>Flow_Mot_TurnoNao</bpmn:incoming>
      <bpmn:outgoing>Flow_Mot_6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Activity_Motorista_ExecutarNovoItinerario" name="Executar novo itinerário / desvio">
      <bpmn:incoming>Flow_Mot_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Mot_5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:receiveTask id="Activity_Motorista_ReceberOrientacao" name="Receber orientação de desvio">
      <bpmn:outgoing>Flow_Mot_4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:manualTask id="Activity_Motorista_RealizarPercurso" name="Realizar percurso da linha">
      <bpmn:incoming>Flow_Mot_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Mot_7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Activity_Motorista_ChegarPontoFinal" name="Chegar ao ponto final / terminal">
      <bpmn:incoming>Flow_Mot_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Mot_8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_Motorista_FimTurno" name="Fim do turno operacional?" default="Flow_Mot_TurnoNao">
      <bpmn:incoming>Flow_Mot_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Mot_TurnoSim</bpmn:outgoing>
      <bpmn:outgoing>Flow_Mot_TurnoNao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Activity_Motorista_FinalizarOperacao" name="Finalizar operação e entregar veículo">
      <bpmn:incoming>Flow_Mot_TurnoSim</bpmn:incoming>
      <bpmn:outgoing>Flow_Mot_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="Event_Motorista_Fim" name="Fim do Turno">
      <bpmn:incoming>Flow_Mot_9</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_CCO_v3" isExecutable="false">
    <bpmn:sequenceFlow id="Flow_CCO_1" sourceRef="Activity_CCO_ReceberOcorrencia" targetRef="Activity_CCO_AvaliarImpacto" />
    <bpmn:sequenceFlow id="Flow_CCO_2" sourceRef="Activity_CCO_AvaliarImpacto" targetRef="Gateway_CCO_AlterarOperacao" />
    <bpmn:sequenceFlow id="Flow_CCO_AlterarNao" name="Não" sourceRef="Gateway_CCO_AlterarOperacao" targetRef="Activity_CCO_Monitorar" />
    <bpmn:sequenceFlow id="Flow_CCO_AlterarSim" name="Sim" sourceRef="Gateway_CCO_AlterarOperacao" targetRef="Activity_CCO_AnalisarLinha" />
    <bpmn:sequenceFlow id="Flow_CCO_3" sourceRef="Activity_CCO_AnalisarLinha" targetRef="Gateway_CCO_TipoAcao" />
    <bpmn:sequenceFlow id="Flow_CCO_AcaoDesvio" name="Desvio de Itinerário" sourceRef="Gateway_CCO_TipoAcao" targetRef="Activity_CCO_OrientarTroca" />
    <bpmn:sequenceFlow id="Flow_CCO_AcaoCarroExtra" name="Solicitar Frota Extra" sourceRef="Gateway_CCO_TipoAcao" targetRef="Activity_CCO_SolicitarVeiculoExtra" />
    <bpmn:sequenceFlow id="Flow_CCO_4" sourceRef="Activity_CCO_OrientarTroca" targetRef="Activity_CCO_Monitorar" />
    <bpmn:sequenceFlow id="Flow_CCO_5" sourceRef="Activity_CCO_SolicitarVeiculoExtra" targetRef="Activity_CCO_Monitorar" />
    <bpmn:sequenceFlow id="Flow_CCO_Loop" sourceRef="Activity_CCO_Monitorar" targetRef="Activity_CCO_ReceberOcorrencia" />
    <bpmn:receiveTask id="Activity_CCO_ReceberOcorrencia" name="Receber notificação manual da ocorrência">
      <bpmn:outgoing>Flow_CCO_1</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Activity_CCO_AvaliarImpacto" name="Avaliar impacto operacional (empírico / reativo)">
      <bpmn:incoming>Flow_CCO_1</bpmn:incoming>
      <bpmn:outgoing>Flow_CCO_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_CCO_AlterarOperacao" name="Necessário alterar operação?" default="Flow_CCO_AlterarNao">
      <bpmn:incoming>Flow_CCO_2</bpmn:incoming>
      <bpmn:outgoing>Flow_CCO_AlterarNao</bpmn:outgoing>
      <bpmn:outgoing>Flow_CCO_AlterarSim</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_CCO_AnalisarLinha" name="Analisar linha afetada e opções de ação">
      <bpmn:incoming>Flow_CCO_AlterarSim</bpmn:incoming>
      <bpmn:outgoing>Flow_CCO_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_CCO_TipoAcao" name="Qual ação reativa tomar?" default="Flow_CCO_AcaoDesvio">
      <bpmn:incoming>Flow_CCO_3</bpmn:incoming>
      <bpmn:outgoing>Flow_CCO_AcaoDesvio</bpmn:outgoing>
      <bpmn:outgoing>Flow_CCO_AcaoCarroExtra</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_CCO_OrientarTroca" name="Orientar troca de itinerário / desvio ao motorista">
      <bpmn:incoming>Flow_CCO_AcaoDesvio</bpmn:incoming>
      <bpmn:outgoing>Flow_CCO_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Activity_CCO_SolicitarVeiculoExtra" name="Solicitar veículo extra à garagem (Reativo)">
      <bpmn:incoming>Flow_CCO_AcaoCarroExtra</bpmn:incoming>
      <bpmn:outgoing>Flow_CCO_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Activity_CCO_Monitorar" name="Monitorar e continuar operação">
      <bpmn:incoming>Flow_CCO_AlterarNao</bpmn:incoming>
      <bpmn:incoming>Flow_CCO_4</bpmn:incoming>
      <bpmn:incoming>Flow_CCO_5</bpmn:incoming>
      <bpmn:outgoing>Flow_CCO_Loop</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmn:process id="Process_Garagem_v3" isExecutable="false">
    <bpmn:sequenceFlow id="Flow_Gar_1" sourceRef="Activity_Garagem_ReceberPedidoExtra" targetRef="Activity_Garagem_DespacharFrotaExtraReativa" />
    <bpmn:sequenceFlow id="Flow_Gar_2" sourceRef="Activity_Garagem_DespacharFrotaExtraReativa" targetRef="Event_Garagem_DespachoReativoFim" />
    <bpmn:receiveTask id="Activity_Garagem_ReceberPedidoExtra" name="Receber solicitação reativa de veículo extra (CCO)">
      <bpmn:outgoing>Flow_Gar_1</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:manualTask id="Activity_Garagem_DespacharFrotaExtraReativa" name="Alocar e despachar veículo reserva com atraso">
      <bpmn:incoming>Flow_Gar_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Gar_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="Event_Garagem_DespachoReativoFim" name="Veículo Extra Despachado de forma Reativa">
      <bpmn:incoming>Flow_Gar_2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_AsIs_v3">
    <bpmndi:BPMNPlane id="BPMNPlane_AsIs_v3" bpmnElement="Collaboration_AsIs_v3">
      <bpmndi:BPMNShape id="Participant_Motorista_v3_di" bpmnElement="Participant_Motorista_v3" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2120" height="460" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Motorista_IniciarOperacao_di" bpmnElement="Activity_Motorista_IniciarOperacao">
        <dc:Bounds x="600" y="208" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_PreparacaoPatio_di" bpmnElement="SubProcess_PreparacaoPatio" isExpanded="false">
        <dc:Bounds x="410" y="208" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Motorista_Inicio_di" bpmnElement="Event_Motorista_Inicio" bioc:stroke="#2e7d32" bioc:fill="#a5d6a7" color:background-color="#a5d6a7" color:border-color="#2e7d32">
        <dc:Bounds x="292" y="228" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="269" y="271" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Motorista_Ocorrencia_di" bpmnElement="Gateway_Motorista_Ocorrencia" isMarkerVisible="true" bioc:stroke="#5b176d" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#5b176d">
        <dc:Bounds x="795" y="223" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="789" y="160" width="62" height="53" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Motorista_ReportarOcorrencia_di" bpmnElement="Activity_Motorista_ReportarOcorrencia" bioc:stroke="#c62828" bioc:fill="#ffebee" color:background-color="#ffebee" color:border-color="#c62828">
        <dc:Bounds x="760" y="350" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Motorista_ContinuarOperacao_di" bpmnElement="Activity_Motorista_ContinuarOperacao">
        <dc:Bounds x="1010" y="208" width="120" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Motorista_ExecutarNovoItinerario_di" bpmnElement="Activity_Motorista_ExecutarNovoItinerario">
        <dc:Bounds x="1210" y="390" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Motorista_ReceberOrientacao_di" bpmnElement="Activity_Motorista_ReceberOrientacao">
        <dc:Bounds x="1560" y="390" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Motorista_RealizarPercurso_di" bpmnElement="Activity_Motorista_RealizarPercurso">
        <dc:Bounds x="1210" y="208" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Motorista_ChegarPontoFinal_di" bpmnElement="Activity_Motorista_ChegarPontoFinal">
        <dc:Bounds x="1460" y="208" width="120" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Motorista_FimTurno_di" bpmnElement="Gateway_Motorista_FimTurno" isMarkerVisible="true" bioc:stroke="#5b176d" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#5b176d">
        <dc:Bounds x="1735" y="223" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1729" y="280" width="63" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Motorista_FinalizarOperacao_di" bpmnElement="Activity_Motorista_FinalizarOperacao">
        <dc:Bounds x="1940" y="208" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0kwcis5_di" bpmnElement="Event_Motorista_Fim" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="2132" y="230" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2118" y="273" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Mot_1_di" bpmnElement="Flow_Mot_1">
        <di:waypoint x="328" y="248" />
        <di:waypoint x="410" y="248" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Mot_2_di" bpmnElement="Flow_Mot_2">
        <di:waypoint x="510" y="248" />
        <di:waypoint x="600" y="248" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Mot_3_di" bpmnElement="Flow_Mot_3">
        <di:waypoint x="720" y="248" />
        <di:waypoint x="795" y="248" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Mot_OcorrenciaNao_di" bpmnElement="Flow_Mot_OcorrenciaNao">
        <di:waypoint x="845" y="248" />
        <di:waypoint x="1010" y="248" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="917" y="230" width="21" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
