<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_ToBe_BusFlow" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:collaboration id="Collaboration_ToBe">
    <bpmn:participant id="Participant_Motorista_ToBe" name="Motorista (Operação de Campo)" processRef="Process_Motorista_ToBe" />
    <bpmn:participant id="Participant_Plataforma_BusFlow" name="Plataforma BusFlow" processRef="Process_Plataforma_BusFlow" />
    <bpmn:participant id="Participant_CCO_ToBe" name="Centro de Controle Operacional (CCO)" processRef="Process_CCO_ToBe" />
    <bpmn:participant id="Participant_Garagem_ToBe" name="Garagem de Veículos" processRef="Process_Garagem_ToBe" />
    <bpmn:messageFlow id="Flow_Msg_BusFlow_to_CCO" name="Notificar Alerta Preditivo" sourceRef="Activity_BusFlow_EnviarCCO" targetRef="Activity_CCO_ReceberAlertaBusFlow" />
    <bpmn:messageFlow id="Flow_Msg_CCO_to_Garagem" name="Transmitir Ordem de Despacho Preventivo (Frota Extra)" sourceRef="Activity_CCO_EmitirOrdemPreventiva" targetRef="Activity_Garagem_ReceberOrdemPreventiva" />
    <bpmn:messageFlow id="Flow_Msg_CCO_to_Motorista" name="Transmitir Orientação Preditiva de Desvio de Itinerário" sourceRef="Activity_CCO_OrientarDesvioPreventivo" targetRef="Activity_Motorista_ReceberOrientacaoPreventiva" />
    <bpmn:textAnnotation id="TextAnnotation_1erlxgx">
      <bpmn:text>Evitando Gargalo por chuva/ Ociosidade</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_11se9hi">
      <bpmn:text>Preditiva de desvio / Otimização de itinerário</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0t58o7e" associationDirection="None" sourceRef="Activity_Motorista_ExecutarItinerarioOtimizado" targetRef="TextAnnotation_1erlxgx" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Motorista_ToBe" isExecutable="false">
    <bpmn:startEvent id="Event_Motorista_Inicio" name="Início da Escala / Turno">
      <bpmn:outgoing>Flow_Mot_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="Activity_Motorista_IniciarOperacao" name="Iniciar operação da linha">
      <bpmn:incoming>Flow_Mot_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Mot_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Activity_Motorista_RealizarPercurso" name="Realizar percurso demandado">
      <bpmn:incoming>Flow_Mot_5</bpmn:incoming>
      <bpmn:incoming>Flow_Mot_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Mot_6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_Motorista_FimTurno" name="Fim do turno operacional?" default="Flow_Mot_TurnoNao">
      <bpmn:incoming>Flow_Mot_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Mot_TurnoSim</bpmn:outgoing>
      <bpmn:outgoing>Flow_Mot_TurnoNao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Activity_Motorista_ChegarPontoFinal" name="Chegar ao ponto final / terminal">
      <bpmn:incoming>Flow_Mot_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Mot_7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Activity_Motorista_FinalizarOperacao" name="Finalizar operação e entregar veículo">
      <bpmn:incoming>Flow_Mot_TurnoSim</bpmn:incoming>
      <bpmn:outgoing>Flow_Mot_8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:subProcess id="SubProcess_PreparacaoPatio" name="Inspeção do Veículo na garagem">
      <bpmn:incoming>Flow_Mot_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Mot_2</bpmn:outgoing>
      <bpmn:startEvent id="Event_Sub_Inicio" name="Início da Preparação na garagem">
        <bpmn:outgoing>Flow_Sub_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:manualTask id="Activity_Sub_ReceberEscala" name="Receber escala do dia">
        <bpmn:incoming>Flow_Sub_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_2</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:manualTask id="Activity_Sub_LocalizarOnibus" name="Localizar ônibus escalado na garagem">
        <bpmn:incoming>Flow_Sub_2</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_3</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:manualTask id="Activity_Sub_InspecionarVeiculo" name="Inspecionar veículo (água, óleo, pneu)">
        <bpmn:incoming>Flow_Sub_3</bpmn:incoming>
        <bpmn:incoming>Flow_Sub_TrocaOK</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_4</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:exclusiveGateway id="Gateway_Sub_VeiculoApto" name="Veículo apto?" default="Flow_Sub_AptoSim">
        <bpmn:incoming>Flow_Sub_4</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_AptoNao</bpmn:outgoing>
        <bpmn:outgoing>Flow_Sub_AptoSim</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Activity_Sub_ComunicarManutencao" name="Comunicar manutenção">
        <bpmn:incoming>Flow_Sub_AptoNao</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateCatchEvent id="Event_Sub_TimerAguardar" name="Aguardar tempo de substituição do veículo">
        <bpmn:incoming>Flow_Sub_5</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_6</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_Sub" />
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="Activity_Sub_ReceberOutroVeiculo" name="Receber Veículo">
        <bpmn:incoming>Flow_Sub_6</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_TrocaOK</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="Event_Sub_Fim" name="Veículo Apto e Liberado para Operar">
        <bpmn:incoming>Flow_Sub_AptoSim</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Sub_1" sourceRef="Event_Sub_Inicio" targetRef="Activity_Sub_ReceberEscala" />
      <bpmn:sequenceFlow id="Flow_Sub_2" sourceRef="Activity_Sub_ReceberEscala" targetRef="Activity_Sub_LocalizarOnibus" />
      <bpmn:sequenceFlow id="Flow_Sub_3" sourceRef="Activity_Sub_LocalizarOnibus" targetRef="Activity_Sub_InspecionarVeiculo" />
      <bpmn:sequenceFlow id="Flow_Sub_4" sourceRef="Activity_Sub_InspecionarVeiculo" targetRef="Gateway_Sub_VeiculoApto" />
      <bpmn:sequenceFlow id="Flow_Sub_AptoNao" name="Não" sourceRef="Gateway_Sub_VeiculoApto" targetRef="Activity_Sub_ComunicarManutencao" />
      <bpmn:sequenceFlow id="Flow_Sub_AptoSim" name="Sim" sourceRef="Gateway_Sub_VeiculoApto" targetRef="Event_Sub_Fim" />
      <bpmn:sequenceFlow id="Flow_Sub_5" sourceRef="Activity_Sub_ComunicarManutencao" targetRef="Event_Sub_TimerAguardar" />
      <bpmn:sequenceFlow id="Flow_Sub_6" sourceRef="Event_Sub_TimerAguardar" targetRef="Activity_Sub_ReceberOutroVeiculo" />
      <bpmn:sequenceFlow id="Flow_Sub_TrocaOK" sourceRef="Activity_Sub_ReceberOutroVeiculo" targetRef="Activity_Sub_InspecionarVeiculo" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_Mot_1" sourceRef="Event_Motorista_Inicio" targetRef="SubProcess_PreparacaoPatio" />
    <bpmn:sequenceFlow id="Flow_Mot_2" sourceRef="SubProcess_PreparacaoPatio" targetRef="Activity_Motorista_IniciarOperacao" />
    <bpmn:sequenceFlow id="Flow_Mot_3" sourceRef="Activity_Motorista_IniciarOperacao" targetRef="Activity_Motorista_RealizarPercurso" />
    <bpmn:sequenceFlow id="Flow_Mot_5" sourceRef="Activity_Motorista_ExecutarItinerarioOtimizado" targetRef="Activity_Motorista_RealizarPercurso" />
    <bpmn:sequenceFlow id="Flow_Mot_TurnoNao" name="Não" sourceRef="Gateway_Motorista_FimTurno" targetRef="Activity_Motorista_RealizarPercurso" />
    <bpmn:sequenceFlow id="Flow_Mot_6" sourceRef="Activity_Motorista_RealizarPercurso" targetRef="Activity_Motorista_ChegarPontoFinal" />
    <bpmn:sequenceFlow id="Flow_Mot_4" sourceRef="Activity_Motorista_ReceberOrientacaoPreventiva" targetRef="Activity_Motorista_ExecutarItinerarioOtimizado" />
    <bpmn:sequenceFlow id="Flow_Mot_7" sourceRef="Activity_Motorista_ChegarPontoFinal" targetRef="Gateway_Motorista_FimTurno" />
    <bpmn:sequenceFlow id="Flow_Mot_TurnoSim" name="Sim" sourceRef="Gateway_Motorista_FimTurno" targetRef="Activity_Motorista_FinalizarOperacao" />
    <bpmn:sequenceFlow id="Flow_Mot_8" sourceRef="Activity_Motorista_FinalizarOperacao" targetRef="Event_Motorista_Fim" />
    <bpmn:manualTask id="Activity_Motorista_ExecutarItinerarioOtimizado" name="Executar itinerário preventivo otimizado">
      <bpmn:incoming>Flow_Mot_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Mot_5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="Event_Motorista_Fim" name="Fim do Turno">
      <bpmn:incoming>Flow_Mot_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="Activity_Motorista_ReceberOrientacaoPreventiva" name="Receber orientação">
      <bpmn:outgoing>Flow_Mot_4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:association id="Association_0u27h31" associationDirection="None" sourceRef="Activity_Motorista_ReceberOrientacaoPreventiva" targetRef="TextAnnotation_11se9hi" />
  </bpmn:process>
  <bpmn:process id="Process_Plataforma_BusFlow" isExecutable="false">
    <bpmn:startEvent id="Event_BusFlow_TimerStart" name="Trigger EventBridge">
      <bpmn:outgoing>Flow_BF_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_BF" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_BusFlow_ProcessarDados" name="Ingestão Serverless &#38; Inferência ML">
      <bpmn:incoming>Flow_BF_1</bpmn:incoming>
      <bpmn:outgoing>Flow_BF_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_BusFlow_RiscoDetectado" name="Diagnóstico preditivo de frota e clima ?" default="Flow_BF_RiscoNao">
      <bpmn:incoming>Flow_BF_2</bpmn:incoming>
      <bpmn:outgoing>Flow_BF_RiscoNao</bpmn:outgoing>
      <bpmn:outgoing>Flow_BF_RiscoChuva</bpmn:outgoing>
      <bpmn:outgoing>Flow_BF_RiscoTempoBom</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_BusFlow_GravarRDS" name="Persistir telemetria e manter monitoramento contínuo no RDS">
      <bpmn:incoming>Flow_BF_RiscoNao</bpmn:incoming>
      <bpmn:outgoing>Flow_BF_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_BusFlow_FimNormal" name="Operação Estável">
      <bpmn:incoming>Flow_BF_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_BusFlow_GerarRecomendacaoChuva" name="Gerar Alerta: Ocorrência / Gargalo por chuva em 1 hora">
      <bpmn:incoming>Flow_BF_RiscoChuva</bpmn:incoming>
      <bpmn:outgoing>Flow_BF_4a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Activity_BusFlow_EnviarCCO" name="Notificar Alerta Preditivo no Dashboard do CCO">
      <bpmn:incoming>Flow_BF_4a</bpmn:incoming>
      <bpmn:incoming>Flow_BF_4b</bpmn:incoming>
      <bpmn:outgoing>Flow_BF_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_BusFlow_AlertaNotificado" name="Alerta Preditivo Notificado ao CCO">
      <bpmn:incoming>Flow_BF_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_BusFlow_GerarRecomendacaoTempoBom" name="Gerar Alerta: Otimização de Frota em Tempo Bom">
      <bpmn:incoming>Flow_BF_RiscoTempoBom</bpmn:incoming>
      <bpmn:outgoing>Flow_BF_4b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_BF_1" sourceRef="Event_BusFlow_TimerStart" targetRef="Activity_BusFlow_ProcessarDados" />
    <bpmn:sequenceFlow id="Flow_BF_2" sourceRef="Activity_BusFlow_ProcessarDados" targetRef="Gateway_BusFlow_RiscoDetectado" />
    <bpmn:sequenceFlow id="Flow_BF_RiscoNao" name="Não" sourceRef="Gateway_BusFlow_RiscoDetectado" targetRef="Activity_BusFlow_GravarRDS" />
    <bpmn:sequenceFlow id="Flow_BF_RiscoChuva" name="Chuva em 1h" sourceRef="Gateway_BusFlow_RiscoDetectado" targetRef="Activity_BusFlow_GerarRecomendacaoChuva" />
    <bpmn:sequenceFlow id="Flow_BF_RiscoTempoBom" name="Tempo Bom (Ociosidade)" sourceRef="Gateway_BusFlow_RiscoDetectado" targetRef="Activity_BusFlow_GerarRecomendacaoTempoBom" />
    <bpmn:sequenceFlow id="Flow_BF_3" sourceRef="Activity_BusFlow_GravarRDS" targetRef="Event_BusFlow_FimNormal" />
    <bpmn:sequenceFlow id="Flow_BF_4a" sourceRef="Activity_BusFlow_GerarRecomendacaoChuva" targetRef="Activity_BusFlow_EnviarCCO" />
    <bpmn:sequenceFlow id="Flow_BF_4b" sourceRef="Activity_BusFlow_GerarRecomendacaoTempoBom" targetRef="Activity_BusFlow_EnviarCCO" />
    <bpmn:sequenceFlow id="Flow_BF_5" sourceRef="Activity_BusFlow_EnviarCCO" targetRef="Event_BusFlow_AlertaNotificado" />
  </bpmn:process>
  <bpmn:process id="Process_CCO_ToBe" isExecutable="false">
    <bpmn:receiveTask id="Activity_CCO_ReceberAlertaBusFlow" name="Receber Alerta Preditivo no Painel">
      <bpmn:outgoing>Flow_CCOTB_1</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Activity_CCO_AvaliarRecomendacao" name="Avaliar recomendação preditiva">
      <bpmn:incoming>Flow_CCOTB_1</bpmn:incoming>
      <bpmn:outgoing>Flow_CCOTB_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_CCO_AprovarDespacho" name="Qual ação tomar?" default="Flow_CCOTB_DespachoEDesvio">
      <bpmn:incoming>Flow_CCOTB_2</bpmn:incoming>
      <bpmn:outgoing>Flow_CCOTB_Desvio</bpmn:outgoing>
      <bpmn:outgoing>Flow_CCOTB_DespachoEDesvio</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_CCOTB_1" sourceRef="Activity_CCO_ReceberAlertaBusFlow" targetRef="Activity_CCO_AvaliarRecomendacao" />
    <bpmn:sequenceFlow id="Flow_CCOTB_2" sourceRef="Activity_CCO_AvaliarRecomendacao" targetRef="Gateway_CCO_AprovarDespacho" />
    <bpmn:sequenceFlow id="Flow_CCOTB_Desvio" name="Desvio de Itinerário" sourceRef="Gateway_CCO_AprovarDespacho" targetRef="Activity_CCO_OrientarDesvioPreventivo" />
    <bpmn:sequenceFlow id="Flow_CCOTB_DespachoEDesvio" name="Despacho" sourceRef="Gateway_CCO_AprovarDespacho" targetRef="Activity_CCO_EmitirOrdemPreventiva" />
    <bpmn:sequenceFlow id="Flow_CCOTB_3a" sourceRef="Activity_CCO_EmitirOrdemPreventiva" targetRef="Activity_CCO_MonitorarImpacto" />
    <bpmn:sequenceFlow id="Flow_CCOTB_3b" sourceRef="Activity_CCO_OrientarDesvioPreventivo" targetRef="Activity_CCO_MonitorarImpacto" />
    <bpmn:sequenceFlow id="Flow_CCOTB_5" sourceRef="Activity_CCO_MonitorarImpacto" targetRef="Event_CCO_PreventivoFim" />
    <bpmn:sendTask id="Activity_CCO_OrientarDesvioPreventivo" name="Orientar desvio preditivo de itinerário ao motorista">
      <bpmn:incoming>Flow_CCOTB_Desvio</bpmn:incoming>
      <bpmn:incoming>Flow_CCOTB_DespachoEDesvio</bpmn:incoming>
      <bpmn:outgoing>Flow_CCOTB_3b</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Activity_CCO_MonitorarImpacto" name="Monitorar regularidade e resposta da frota no painel">
      <bpmn:incoming>Flow_CCOTB_3a</bpmn:incoming>
      <bpmn:incoming>Flow_CCOTB_3b</bpmn:incoming>
      <bpmn:outgoing>Flow_CCOTB_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Activity_CCO_EmitirOrdemPreventiva" name="Emitir Ordem de Despacho para a garagem">
      <bpmn:incoming>Flow_CCOTB_DespachoEDesvio</bpmn:incoming>
      <bpmn:outgoing>Flow_CCOTB_3a</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_CCO_PreventivoFim" name="Ação Preventiva Executada">
      <bpmn:incoming>Flow_CCOTB_5</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_Garagem_ToBe" isExecutable="false">
    <bpmn:manualTask id="Activity_Garagem_DespacharFrotaPreventiva" name="Alocar e despachar veículo reserva de forma PREVENTIVA">
      <bpmn:incoming>Flow_Gar_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Gar_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="Event_Garagem_SucessoFim" name="Frota Extra em Campo">
      <bpmn:incoming>Flow_Gar_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="Activity_Garagem_ReceberOrdemPreventiva" name="Receber Ordem de Despacho Preventivo">
      <bpmn:outgoing>Flow_Gar_1</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sequenceFlow id="Flow_Gar_1" sourceRef="Activity_Garagem_ReceberOrdemPreventiva" targetRef="Activity_Garagem_DespacharFrotaPreventiva" />
    <bpmn:sequenceFlow id="Flow_Gar_2" sourceRef="Activity_Garagem_DespacharFrotaPreventiva" targetRef="Event_Garagem_SucessoFim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ToBe">
    <bpmndi:BPMNPlane id="BPMNPlane_ToBe" bpmnElement="Collaboration_ToBe">
      <bpmndi:BPMNShape id="Participant_Motorista_ToBe_di" bpmnElement="Participant_Motorista_ToBe" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1900" height="460" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Motorista_Inicio_di" bpmnElement="Event_Motorista_Inicio" bioc:stroke="#2e7d32" bioc:fill="#a5d6a7" color:background-color="#a5d6a7" color:border-color="#2e7d32">
        <dc:Bounds x="292" y="228" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="269" y="271" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Motorista_IniciarOperacao_di" bpmnElement="Activity_Motorista_IniciarOperacao">
        <dc:Bounds x="600" y="208" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Motorista_RealizarPercurso_di" bpmnElement="Activity_Motorista_RealizarPercurso">
        <dc:Bounds x="850" y="206" width="120" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Motorista_FimTurno_di" bpmnElement="Gateway_Motorista_FimTurno" isMarkerVisible="true" bioc:stroke="#5b176d" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#5b176d">
        <dc:Bounds x="1345" y="221" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1339" y="278" width="63" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Motorista_ChegarPontoFinal_di" bpmnElement="Activity_Motorista_ChegarPontoFinal">
        <dc:Bounds x="1100" y="206" width="120" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Motorista_FinalizarOperacao_di" bpmnElement="Activity_Motorista_FinalizarOperacao">
        <dc:Bounds x="1570" y="206" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Motorista_ExecutarItinerarioOtimizado_di" bpmnElement="Activity_Motorista_ExecutarItinerarioOtimizado">
        <dc:Bounds x="850" y="380" width="120" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Motorista_Fim_di" bpmnElement="Event_Motorista_Fim" bioc:stroke="#2e7d32" bioc:fill="#a5d6a7" color:background-color="#a5d6a7" color:border-color="#2e7d32">
        <dc:Bounds x="1952" y="228" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1938" y="271" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Motorista_ReceberOrientacaoPreventiva_di" bpmnElement="Activity_Motorista_ReceberOrientacaoPreventiva">
        <dc:Bounds x="1310" y="380" width="120" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_PreparacaoPatio_di" bpmnElement="SubProcess_PreparacaoPatio" isExpanded="false">
        <dc:Bounds x="410" y="208" width="100" height="80" />
        <bpmndi:BPMNLabel />
